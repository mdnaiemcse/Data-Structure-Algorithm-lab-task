#include <iostream>
using namespace std;

int main() {
    int A[] = {1, 4, 6, 3, 6};
    int B[] = {5, 3, 7, 1, 2, 6};
    
    int sizeA = sizeof(A) / sizeof(A[0]);
    int sizeB = sizeof(B) / sizeof(B[0]);
    
    int C[100]; 
    int count = 0;

    for (int i = 0; i < sizeA; i++) {
        for (int j = 0; j < sizeB; j++) {
            
            if (A[i] == B[j]) {
                
             
                bool alreadyExists = false;
                for (int k = 0; k < count; k++) {
                    if (C[k] == A[i]) {
                        alreadyExists = true;
                        break;
                    }
                }

           
                if (!alreadyExists) {
                    C[count] = A[i];
                    count++;
                }
                
            }
        }
    }

    
    if (count == 0) {
        cout << "No common element!" << endl;
    } else {
        cout << "Output: ";
        for (int i = 0; i < count; i++) {
            cout << C[i] << " ";
        }
        cout << endl;
    }

    return 0;

