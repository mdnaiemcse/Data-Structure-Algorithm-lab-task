include <iostream>
using namespace std;
     
 printOdds(int start, int end) {
    cout << "Odd numbers between " << start << " and " << end << " are: ";
    for (int i = start; i <= end; i++) {
        //      
        if (i % 2 != 0) {
            cout << i << " ";
        }
    }
    cout << endl;
}

int main() {
    int start, end;
    cout << "Enter starting value: ";
    cin >> start;
    cout << "Enter ending value: ";
    cin >> end;

     
    printOdds(start, end);
    return 0;
}
