#include <iostream>
using namespace std;


int checkPrime(int n) {
    if (n <= 1) return 0;
    for (int i = 2; i <n; i++) {
        if (n % i == 0) {
            return 0; 
        }
    }
    return 1;
}


long long getFact(int n) {
    long long f = 1;
    for (int i = 1; i <= n; i++) {
        f = f * i;
    }
    return f;
}

int main() {
    int num;
    cout << "Enter a number: ";
    cin >> num;

    if (checkPrime(num) == 1) {
        cout << "Factorial: " << getFact(num) << endl;
    } else {
        cout << "Error: Not a prime number!" << endl;
    }

    return 0;
}
